---
import InlineText from './InlineText.astro';

const { notes } = Astro.props;
---
<ul class="usage-list">
  {notes.map(({ text, evidence }) => (
    <li>
      <p><InlineText value={text} /></p>
      <details class="field-evidence">
        <summary>Evidence</summary>
        <ul>{evidence.map((ref) => <li><code>{ref}</code></li>)}</ul>
      </details>
    </li>
  ))}
</ul>
