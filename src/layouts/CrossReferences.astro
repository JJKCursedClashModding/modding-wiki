---
import { fieldAnchor, hrefFor } from '../data.js';

const { entries } = Astro.props;
const byTable = new Map();
for (const { table, field } of entries) {
  if (!byTable.has(table)) byTable.set(table, []);
  byTable.get(table).push(field);
}
---
<ul class="cross-references">
  {[...byTable].map(([table, fields]) => (
    <li>
      <a href={hrefFor(table)}><code>{table}</code></a>
      <ul>
        {fields.map((field) => <li><a href={`${hrefFor(table)}#${fieldAnchor(field)}`}><code>{field}</code></a></li>)}
      </ul>
    </li>
  ))}
</ul>
