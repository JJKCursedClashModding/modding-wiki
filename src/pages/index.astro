---
import Reference from '../layouts/Reference.astro';
import { categories, groups, hrefFor } from '../data.js';

const featured = ['AttackDataTable', 'DamageDataTable', 'ActionHomingDataTable', 'CharacterDataTable']
  .map((id) => groups.find((group) => group.id === id)).filter(Boolean);
const totalAssets = groups.reduce((sum, group) => sum + group.variants.length, 0);
const totalFields = groups.reduce((sum, group) => sum + group.fields.length, 0);
---
<Reference title="Overview" description="See what each game setting does in Jujutsu Kaisen Cursed Clash.">
  <section class="intro">
    <span class="eyebrow">Unreal Engine reference</span>
    <h1>Jujutsu Kaisen CC<br /><em>DataTables</em></h1>
    <p>Find a setting and see what it changes in the game. Open its technical details when you need the exact rules.</p>
    <dl class="metrics">
      <div><dt>Table groups</dt><dd>{groups.length.toLocaleString('en-US')}</dd></div>
      <div><dt>Exported assets</dt><dd>{totalAssets.toLocaleString('en-US')}</dd></div>
      <div><dt>Settings documented</dt><dd>{totalFields.toLocaleString('en-US')}</dd></div>
    </dl>
  </section>
  <section class="overview-section" aria-labelledby="featured">
    <h2 id="featured">Combat essentials</h2>
    <div class="tile-grid featured">
      {featured.map((group) => (
        <a class="tile" href={hrefFor(group.id)}>
          <h3>{group.id}</h3>
          <p>{group.overview ?? group.description ?? `${group.fields.length} settings`}</p>
        </a>
      ))}
    </div>
  </section>
  <section class="overview-section" aria-labelledby="catalog">
    <h2 id="catalog">Browse by category</h2>
    <div class="tile-grid">
      {categories.map((category) => (
        <details class="tile category-tile" id={category.id}>
          <summary><span>{category.label}</span><span class="nav-count">{category.groups.length}</span></summary>
          <ul>
            {category.groups.map((group) => <li><a href={hrefFor(group.id)}>{group.id}</a></li>)}
          </ul>
        </details>
      ))}
    </div>
  </section>
  <section class="overview-section methodology" aria-labelledby="coverage">
    <h2 id="coverage">Reading the reference</h2>
    <p>Related files share a page, including numbered tables and language versions. The row-key browser lists individual entries and the files they come from.</p>
    <p>Open Technical details for the Unreal type, exact behavior, and supporting evidence. The available game data and reconstructed code cover part of the shipped game, so some settings have an unclear effect.</p>
  </section>
</Reference>
