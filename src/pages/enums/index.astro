---
import Reference from '../../layouts/Reference.astro';
import InlineText from '../../layouts/InlineText.astro';
import { enumHref, enums } from '../../data.js';
---
<Reference title="Enums" description="Browse named choices and what they do in the game." section="enums">
  <h1 class="table-title">Enums</h1>
  <p class="lead">An enum is a list of named choices. Open one to see what each choice means and which settings use it.</p>
  <ul class="reference-index reference-list">
    {enums.map((entry) => (
      <li>
        <h2><a href={enumHref(entry.id)}><code>{entry.id}</code></a></h2>
        <p><InlineText value={entry.overview} /></p>
      </li>
    ))}
  </ul>
</Reference>
