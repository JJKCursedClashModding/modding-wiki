---
import Reference from '../../layouts/Reference.astro';
import { categories, hrefFor } from '../../data.js';
---
<Reference title="DataTables" description="Browse settings by part of the game." section="tables">
  <h1 class="table-title">DataTables</h1>
  <p class="lead">Browse settings by part of the game. Related files, including numbered tables and language versions, share a page.</p>
  <div class="tile-grid reference-index">
    {categories.map((category) => (
      <details class="tile category-tile" id={category.id}>
        <summary><span>{category.label}</span><span class="nav-count">{category.groups.length}</span></summary>
        <ul>
          {category.groups.map((group) => <li><a href={hrefFor(group.id)}>{group.id}</a></li>)}
        </ul>
      </details>
    ))}
  </div>
  <script>
    function openLinkedCategory() {
      const category = document.getElementById(location.hash.slice(1));
      if (category instanceof HTMLDetailsElement) category.open = true;
    }
    window.addEventListener('hashchange', openLinkedCategory);
    openLinkedCategory();
  </script>
</Reference>
