---
import Reference from '../../layouts/Reference.astro';
import InlineText from '../../layouts/InlineText.astro';
import CrossReferences from '../../layouts/CrossReferences.astro';
import { characterHref, characterRowOwners, characters, uniqueRowAnchor } from '../../characters.js';
import { categoryNames, enumHref, fieldAnchor, fieldParentName, groups, hrefFor, referencedBy, slugFor } from '../../data.js';

export function getStaticPaths() {
  return groups.map((group) => ({ params: { slug: slugFor(group.id) }, props: { group } }));
}

const { group } = Astro.props;
const base = import.meta.env.BASE_URL;
const statuses = {
  verified: 'Consumer traced',
  observed: 'Observed',
  unresolved: 'Unresolved',
  pending: 'Pending review',
};
const formatCount = (value) => value.toLocaleString('en-US');
const refs = Object.entries(group.references);
const incoming = referencedBy.get(group.id);
const fieldGroups = new Map(group.fields.map((field) => [field.name.toLowerCase(), { field, components: [] }]));
for (const field of group.fields) {
  const parent = field.componentOf && fieldGroups.get(fieldParentName(field.name));
  if (parent) {
    parent.components.push(field);
    fieldGroups.delete(field.name.toLowerCase());
  }
}
const fieldColumns = [
  ['.field-heading a', 'Name'],
  ['.field-type', 'Type'],
  ['.simple', 'Description'],
];
const componentCount = group.fields.length - fieldGroups.size;
let rowLinks = {};
if (group.id === 'CharacterDataTable') {
  rowLinks = Object.fromEntries(characters.map(({ id, name }) => [id, [[name, characterHref(id)]]]));
} else if (group.id === 'CharacterUniqueDataTable') {
  rowLinks = Object.fromEntries([...characterRowOwners].map(([key, owners]) => [key, owners.map(({ id, name, index }) => [
    name, `${characterHref(id)}#${uniqueRowAnchor(index)}`,
  ])]));
}
---
<Reference title={group.id} description={group.overview ?? group.description ?? `Unreal schema for ${group.id}.`} current={group.id} section="tables">
  <div class="doc-grid">
    <article class="doc">
      <div class="breadcrumb"><a href={`${base}tables/`}>DataTables</a><span aria-hidden="true">/</span><a href={`${base}tables/#${group.category}`}>{categoryNames[group.category]}</a></div>
      <h1 class="table-title">{group.id}</h1>
      <p class="lead"><InlineText value={group.overview ?? group.description ?? 'Purpose is pending review.'} /></p>
      {['CharacterDataTable', 'CharacterUniqueDataTable'].includes(group.id) && (
        <p class="section-intro"><a href={`${base}characters/`}>Browse unique rows and their values by character</a></p>
      )}
      <details class="table-details">
        <summary>Table details</summary>
        {group.overview && group.description && group.overview !== group.description && (
          <p class="technical"><InlineText value={group.description} /></p>
        )}
        <dl class="specs">
          <div><dt>Unreal row struct</dt><dd><code>F{group.rowStruct}</code></dd></div>
          <div><dt>Asset variants</dt><dd>{formatCount(group.variants.length)}</dd></div>
          <div><dt>Distinct row keys</dt><dd>{formatCount(group.rowKeyCount)}</dd></div>
        </dl>
      </details>

      <section id="fields" class="doc-section">
        <h2 id="fields-heading">Settings</h2>
        <div class="field-tools">
          <input class="filter" type="search" id="field-filter" aria-label="Filter settings" placeholder="Filter by name, type, or description" autocomplete="off" />
          <p class="field-count" id="field-count" role="status">{formatCount(fieldGroups.size)} {fieldGroups.size === 1 ? 'setting' : 'settings'}{componentCount > 0 && ` · ${formatCount(componentCount)} ${componentCount === 1 ? 'component' : 'components'}`}</p>
        </div>
        <table class="field-table" role="table" aria-labelledby="fields-heading">
          <colgroup><col class="field-name-column" /><col class="field-type-column" /><col /></colgroup>
          <thead role="rowgroup">
            <tr role="row">
              {fieldColumns.map(([selector, label], index) => (
                <th scope="col" role="columnheader" aria-sort={index === 0 ? 'ascending' : undefined}>
                  <button type="button" class="field-sort" data-sort={selector}>
                    {label}<span class="sort-arrow" aria-hidden="true"></span>
                  </button>
                </th>
              ))}
            </tr>
          </thead>
          {[...fieldGroups.values()].map(({ field: parent, components }) => (
            <tbody class="field-group" role="rowgroup">
              {[parent, ...components].map((field) => {
                const child = field !== parent;
                const label = child ? field.name.split('.').at(-1) : field.name;
                const type = field.type || 'Unknown';
                const enumOffset = field.enumId ? type.indexOf(field.enumId) : -1;
                const evidence = [...new Set([field.source, ...(field.evidence ?? []), ...field.links.flatMap((link) => link.evidence)].filter(Boolean))];
                return (
                  <tr class:list={['field', { 'field-component': child }]} id={fieldAnchor(field.name)} role="row" data-field-name={field.name}>
                    <th scope="row" role="rowheader" class="field-heading">
                      <a href={`#${fieldAnchor(field.name)}`} aria-label={child ? field.name : undefined} title={child ? field.name : undefined}><code>{label}</code></a>
                      {!child && components.length > 0 && (
                        <button type="button" class="component-toggle" hidden
                          aria-expanded="false" aria-controls={components.map((item) => fieldAnchor(item.name)).join(' ')}
                          aria-label={`${components.length} components of ${parent.name}`}>
                          {components.length} components
                        </button>
                      )}
                    </th>
                    <td class="field-type" role="cell"><code>{enumOffset < 0 ? type : <>{type.slice(0, enumOffset)}<a href={enumHref(field.enumId)}>{field.enumId}</a>{type.slice(enumOffset + field.enumId.length)}</>}</code></td>
                    <td class="field-body" role="cell">
                      <p class="simple"><InlineText value={field.simple ?? 'Definition pending review.'} /></p>
                      {!!field.links.length && <ul class="outgoing-links" aria-label="Related DataTables">{field.links.map(({ table, note }) => (
                        <li><a href={hrefFor(table)}><code>{table}</code></a>{note && <> <span>· <InlineText value={note} /></span></>}</li>
                      ))}</ul>}
                      <details class="field-details">
                        <summary>Technical details</summary>
                        <div class="field-metadata">
                          <span class:list={['badge', field.status]}>{statuses[field.status] ?? field.status}</span>
                          {field.nativeName && field.nativeName !== field.name && !field.name.includes('.') && <span>Unreal property <code>{field.nativeName}</code></span>}
                          {!field.exportKinds.length && <span>Declaration only</span>}
                          {field.exportOnly && <span>Export representation</span>}
                          {field.seenInVariants > 0 && field.seenInVariants < group.variants.length && (
                            <span>Present in {field.seenInVariants} of {group.variants.length} exports</span>
                          )}
                        </div>
                        {field.technical && <p class="technical"><InlineText value={field.technical} /></p>}
                        {!!evidence.length && (
                          <details class="field-evidence">
                            <summary>Evidence</summary>
                            <ul>{evidence.map((ref) => <li><code>{ref}</code></li>)}</ul>
                          </details>
                        )}
                      </details>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          ))}
        </table>
        <p id="field-empty" class="field-empty" hidden>No settings match this filter.</p>
      </section>

      <section id="variants" class="doc-section">
        <h2>Assets & row keys</h2>
        {group.variants.length ? <>
        <p class="section-intro">{formatCount(group.assetRowCount)} records across the available variants. {group.repeatedKeys ? `${formatCount(group.repeatedKeys)} row keys recur in multiple variants.` : ''}</p>
        <div class="table-wrap"><table>
          <thead><tr><th scope="col">Asset</th><th scope="col">Rows</th><th scope="col">Import key</th></tr></thead>
          <tbody>{group.variants.map(({ name, rows, importKey }) => <tr><td><code>{name}</code></td><td>{formatCount(rows)}</td><td><code>{importKey ?? '—'}</code></td></tr>)}</tbody>
        </table></div>
        <details class="key-browser" data-key-file={`${base}row-keys/${slugFor(group.id)}.json`} data-variants={JSON.stringify(group.variants.map(({ name }) => name))} data-row-links={Object.keys(rowLinks).length ? JSON.stringify(rowLinks) : undefined}>
          <summary>Browse {formatCount(group.rowKeyCount)} row keys</summary>
          <label class="filter-label" for="key-filter">Find a row key</label>
          <input class="filter" type="search" id="key-filter" placeholder="Row key" autocomplete="off" />
          <p class="key-status muted" role="status"></p>
          <ul class="key-results"></ul>
        </details>
        </> : <p class="section-intro">The native consumer defines this table’s schema. The available exports contain no matching asset.</p>}
      </section>

      <section id="usage" class="doc-section">
        <h2>Code usage</h2>
        {group.usages.length ? <ul class="usage-list">{group.usages.map(({ source, detail }) => (
          <li><p><InlineText value={detail} /></p><code>{source}</code></li>
        ))}</ul> : <p class="section-intro">A technical summary of the consumers is pending review.</p>}
        {refs.length > 0 && (
          <details class="reference-files">
            <summary>Source reference index · {refs.length} files</summary>
            <p class="muted">Matches for asset names, row structs, and known accessors. The index includes declarations and setup.</p>
            <ul>{refs.map(([file, symbols]) => <li>
              <code>{file}</code>
              <ul>{Object.entries(symbols).map(([symbol, lines]) => <li><code>{symbol}</code> <span>· {Array.from(new Set(lines)).join(', ')}</span></li>)}</ul>
            </li>)}</ul>
          </details>
        )}
      </section>

      {!!incoming.length && (
        <section id="referenced-by" class="doc-section">
          <h2>Referenced by</h2>
          <CrossReferences entries={incoming} />
        </section>
      )}
      <section id="notes" class="doc-section">
        <h2>Notes</h2>
        {group.notes.length ? <ul class="notes">{group.notes.map((note) => <li><InlineText value={note} /></li>)}</ul> : <p class="section-intro">Additional findings are pending review.</p>}
      </section>
    </article>
    <nav class="toc" aria-label="On this page">
      <strong>On this page</strong>
      <a href="#fields">Settings</a>
      <a href="#variants">Assets & row keys</a>
      <a href="#usage">Code usage</a>
      {!!incoming.length && <a href="#referenced-by">Referenced by</a>}
      <a href="#notes">Notes</a>
    </nav>
  </div>
  <script>
    const fieldFilter = document.querySelector('#field-filter');
    const fieldCount = document.querySelector('#field-count');
    const fieldEmpty = document.querySelector('#field-empty');
    const table = document.querySelector('.field-table');
    const fields = [...table.querySelectorAll('.field')];
    const fieldText = new Map(fields.map((row) => [row, `${row.dataset.fieldName} ${row.textContent}`.toLowerCase()]));
    const fieldGroups = [...table.tBodies].map((body) => {
      const [parent, ...components] = body.rows;
      return { body, parent, components, toggle: parent.querySelector('.component-toggle'), expanded: false, filteredExpansion: null };
    });
    const unfilteredCount = fieldCount.textContent;
    const collator = new Intl.Collator('en', { numeric: true, sensitivity: 'base' });

    function filterFields() {
      const query = fieldFilter.value.trim().toLowerCase();
      const matches = (row) => !query || fieldText.get(row).includes(query);
      let count = 0;
      for (const group of fieldGroups) {
        const parentMatches = matches(group.parent);
        const matchedComponents = new Set(group.components.filter(matches));
        group.body.hidden = !parentMatches && !matchedComponents.size;
        const expanded = query ? (group.filteredExpansion ?? true) : group.expanded;
        if (group.toggle) {
          group.toggle.hidden = !!query && !matchedComponents.size;
          group.toggle.setAttribute('aria-expanded', String(expanded && matchedComponents.size > 0));
        }
        for (const row of group.components) row.hidden = !expanded || !matchedComponents.has(row);
        count += Number(parentMatches) + matchedComponents.size;
      }
      fieldCount.textContent = query ? `${count} ${count === 1 ? 'match' : 'matches'}` : unfilteredCount;
      fieldEmpty.hidden = count > 0;
    }

    fieldFilter.addEventListener('input', () => {
      for (const group of fieldGroups) group.filteredExpansion = null;
      filterFields();
    });
    for (const group of fieldGroups) {
      group.toggle?.addEventListener('click', () => {
        const expanded = group.toggle.getAttribute('aria-expanded') === 'true';
        if (fieldFilter.value.trim()) group.filteredExpansion = !expanded;
        else group.expanded = !expanded;
        filterFields();
      });
    }

    function revealLinkedField() {
      const target = document.getElementById(location.hash.slice(1));
      const group = target?.classList.contains('field') && fieldGroups.find(({ body }) => body === target.parentElement);
      if (group && (target.hidden || group.body.hidden)) {
        fieldFilter.value = '';
        if (target !== group.parent) group.expanded = true;
        filterFields();
        target.scrollIntoView();
      }
    }
    window.addEventListener('hashchange', revealLinkedField);

    function sortFields(button, direction) {
      const selector = button.dataset.sort;
      const values = new Map(fieldGroups.map(({ parent }) => [parent, parent.querySelector(selector).textContent.trim()]));
      fieldGroups.sort((a, b) => direction * collator.compare(values.get(a.parent), values.get(b.parent))
        || collator.compare(a.parent.dataset.fieldName, b.parent.dataset.fieldName));
      table.append(...fieldGroups.map(({ body }) => body));
    }

    const sortButtons = [...table.querySelectorAll('.field-sort')];
    for (const button of sortButtons) {
      button.addEventListener('click', () => {
        const header = button.closest('th');
        const descending = header.getAttribute('aria-sort') === 'ascending';
        table.querySelector('th[aria-sort]')?.removeAttribute('aria-sort');
        header.setAttribute('aria-sort', descending ? 'descending' : 'ascending');
        sortFields(button, descending ? -1 : 1);
      });
    }

    sortFields(sortButtons[0], 1);
    filterFields();
    revealLinkedField();

    const browser = document.querySelector('.key-browser');
    if (browser) enableKeyBrowser(browser);

    function enableKeyBrowser(browser) {
      const keyStatus = browser.querySelector('.key-status');
      const keyResults = browser.querySelector('.key-results');
      const keyFilter = browser.querySelector('#key-filter');
      const variants = JSON.parse(browser.dataset.variants);
      const rowLinks = new Map(Object.entries(JSON.parse(browser.dataset.rowLinks ?? '{}')));
      let keyData;
      let request;

      function renderKeys() {
        if (!keyData) return;
        const query = keyFilter.value.trim().toLowerCase();
        const matches = keyData.filter(([key]) => key.toLowerCase().includes(query));
        keyResults.replaceChildren();
        keyStatus.textContent = `${matches.length.toLocaleString()} matches${matches.length > 50 ? ' · showing the first 50' : ''}`;
        for (const [key, indices] of matches.slice(0, 50)) {
          const item = document.createElement('li');
          const name = document.createElement('code');
          const assets = document.createElement('small');
          name.textContent = key;
          assets.textContent = indices.map((index) => variants[index]).join(', ');
          item.append(name, assets);
          const links = rowLinks.get(key);
          if (links) {
            const related = document.createElement('div');
            related.className = 'key-character-links';
            for (const [label, href] of links) {
              const link = document.createElement('a');
              link.textContent = label;
              link.href = href;
              related.append(link);
            }
            item.append(related);
          }
          keyResults.append(item);
        }
      }

      browser.addEventListener('toggle', async () => {
        if (!browser.open || keyData || request) return;
        keyStatus.textContent = 'Loading row keys…';
        try {
          request = fetch(browser.dataset.keyFile);
          const response = await request;
          if (!response.ok) throw new Error('Row keys unavailable');
          keyData = await response.json();
          renderKeys();
        } catch {
          keyStatus.textContent = 'Row keys could not load. Reopen this section to retry.';
        } finally {
          request = undefined;
        }
      });
      keyFilter.addEventListener('input', renderKeys);
    }
  </script>
</Reference>
