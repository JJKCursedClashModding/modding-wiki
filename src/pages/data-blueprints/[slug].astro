---
import Reference from '../../layouts/Reference.astro';
import InlineText from '../../layouts/InlineText.astro';
import { blueprints, fieldAnchor, hrefFor } from '../../data.js';

export function getStaticPaths() {
  return blueprints.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<Reference title={entry.title} description={entry.overview} current={entry.id} section="data-blueprints">
  <article class="doc">
    <div class="breadcrumb"><a href={base}>Overview</a><span aria-hidden="true">/</span><a href={`${base}data-blueprints/`}>Data Blueprints</a></div>
    <h1 class="table-title">{entry.title}</h1>
    <p class="lead"><InlineText value={entry.overview} /></p>
    <details class="table-details">
      <summary>Technical details</summary>
      <p class="technical"><InlineText value={entry.description} /></p>
      <p class="technical">Base class <code>{entry.baseClass}</code></p>
      <ul class="notes">{entry.evidence.map((ref) => <li><code>{ref}</code></li>)}</ul>
    </details>
    {!!entry.examples.length && (
      <section class="doc-section" id="examples">
        <h2>Blueprints</h2>
        <ul class="reference-list reference-index">
          {entry.examples.map(({ name, path, detail }) => (
            <li><h3><code>{name}</code></h3><p><InlineText value={detail} /></p><small><code>{path}</code></small></li>
          ))}
        </ul>
      </section>
    )}
    {!!entry.fields.length && (
      <section class="doc-section" id="fields">
        <h2 id="settings-heading">Settings</h2>
        <table class="value-table reference-index" aria-labelledby="settings-heading">
          <thead><tr><th scope="col">Name</th><th scope="col">Type</th><th scope="col">Description</th></tr></thead>
          <tbody>
            {entry.fields.map((field) => (
              <tr class="field" id={fieldAnchor(field.name)}>
                <th scope="row" class="field-heading"><a href={`#${fieldAnchor(field.name)}`}><code>{field.name}</code></a></th>
                <td class="field-type"><code>{field.type}</code></td>
                <td>
                  <p class="simple"><InlineText value={field.simple} /></p>
                  <details class="field-details">
                    <summary>Technical details</summary>
                    <p class="technical"><InlineText value={field.technical} /></p>
                    <ul class="notes">{field.evidence.map((ref) => <li><code>{ref}</code></li>)}</ul>
                  </details>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    )}
    {!!entry.tables.length && (
      <section class="doc-section" id="tables">
        <h2>Related DataTables</h2>
        <ul class="notes">{entry.tables.map((id) => <li><a href={hrefFor(id)}><code>{id}</code></a></li>)}</ul>
      </section>
    )}
    {!!entry.notes.length && (
      <section class="doc-section" id="notes">
        <h2>Notes</h2>
        <ul class="notes">{entry.notes.map((note) => <li><InlineText value={note} /></li>)}</ul>
      </section>
    )}
  </article>
</Reference>
