---
import Reference from '../../layouts/Reference.astro';
import InlineText from '../../layouts/InlineText.astro';
import { blueprintHref, blueprintNotes, blueprintOverview, blueprints } from '../../data.js';

const families = [
  { kind: 'settings', title: 'Settings and defaults' },
  { kind: 'actor', title: 'Related actor Blueprints' },
];
---
<Reference title="Data Blueprints" description={blueprintOverview} section="data-blueprints">
  <h1 class="table-title">Data Blueprints</h1>
  <p class="lead"><InlineText value={blueprintOverview} /></p>
  {families.map(({ kind, title }) => (
    <section class="doc-section" id={kind}>
      <h2>{title}</h2>
      <ul class="reference-index reference-list">
        {blueprints.filter((entry) => entry.kind === kind).map((entry) => (
          <li>
            <h3><a href={blueprintHref(entry.id)}>{entry.title}</a></h3>
            <p><InlineText value={entry.overview} /></p>
          </li>
        ))}
      </ul>
    </section>
  ))}
  {!!blueprintNotes.length && (
    <section class="doc-section" id="notes">
      <h2>Notes</h2>
      <ul class="notes">{blueprintNotes.map((note) => <li><InlineText value={note} /></li>)}</ul>
    </section>
  )}
</Reference>
